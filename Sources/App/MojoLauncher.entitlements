<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Raise the jetsam limit: JVM heap + GL translation buffers exceed the
	     default per-app memory ceiling on most devices. Honored on iOS 15+
	     including sideloaded/dev-signed installs. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- HotSpot reserves large virtual ranges (heap, metaspace, mapped jars). -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
