{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bh:shockwave",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bh_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 180
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.5,
        "offset": [0, 0, 0],
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "12 + variable.particle_random_1 * 10",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + variable.particle_random_2 * 0.5"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5 * (1 - variable.particle_age / variable.particle_lifetime) + 0.1",
          "0.5 * (1 - variable.particle_age / variable.particle_lifetime) + 0.1"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [0, 0],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.3": "#FFCC88FF",
            "0.7": "#FF6A1FB4",
            "1.0": "#FF0A0114"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
