{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bh:vortex",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bh_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 8
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.1 + variable.particle_random_1 * 0.6"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(2.5 + variable.particle_random_1 * 2.5) * variable.bh_size * (1 - variable.particle_age / variable.particle_lifetime) * math.cos(variable.particle_random_2 * 360 + variable.particle_age * (480 + variable.particle_random_3 * 360))",
          "(variable.particle_random_4 - 0.5) * 4 * variable.bh_size * (1 - variable.particle_age / variable.particle_lifetime)",
          "(2.5 + variable.particle_random_1 * 2.5) * variable.bh_size * (1 - variable.particle_age / variable.particle_lifetime) * math.sin(variable.particle_random_2 * 360 + variable.particle_age * (480 + variable.particle_random_3 * 360))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3 * (1 - variable.particle_age / variable.particle_lifetime) + 0.05",
          "0.3 * (1 - variable.particle_age / variable.particle_lifetime) + 0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [0, 0],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFB14CF0",
            "0.5": "#FF7716C9",
            "1.0": "#FF120318"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
