{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bh:aura",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/bh_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "3.5 * variable.bh_size",
        "offset": [0, 0, 0],
        "direction": "inwards"
      },
      "minecraft:particle_initial_speed": 1.4,
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.6 + variable.particle_random_1 * 0.8"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.7 + variable.particle_random_2 * 0.5",
          "0.7 + variable.particle_random_2 * 0.5"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [0, 0],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#C805010A",
            "1.0": "#F0000000"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
