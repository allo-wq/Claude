{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bh:event_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bh_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.0
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(2.1 + variable.particle_random_1 * 1.4) * variable.bh_size * math.cos(variable.particle_random_2 * 360 + variable.particle_age * 720)",
          "math.sin(variable.particle_random_2 * 360 + variable.particle_age * 720 + variable.particle_random_3 * 360) * (2.1 + variable.particle_random_1 * 1.4) * variable.bh_size * 0.35",
          "(2.1 + variable.particle_random_1 * 1.4) * variable.bh_size * math.sin(variable.particle_random_2 * 360 + variable.particle_age * 720)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [0.14, 0.14],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [0, 0],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FFE8DCFF",
            "0.6": "#FFAA55FF",
            "1.0": "#FF33064A"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
