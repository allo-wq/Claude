{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "veil:noxhollow",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "veil:phase": {
          "type": "int",
          "range": [1, 3],
          "default": 1,
          "client_sync": true
        }
      }
    },

    "component_groups": {
      "veil:phase1": {
        "minecraft:behavior.ranged_attack": {
          "priority": 2,
          "attack_interval_min": 3.0,
          "attack_interval_max": 5.0,
          "attack_radius": 14.0,
          "speed_multiplier": 1.0
        },
        "minecraft:shooter": {
          "def": "veil:soul_ember"
        }
      },

      "veil:phase2": {
        "minecraft:movement": { "value": 0.28 },
        "minecraft:attack": { "damage": 14 },
        "minecraft:behavior.ranged_attack": {
          "priority": 2,
          "attack_interval_min": 2.5,
          "attack_interval_max": 4.0,
          "attack_radius": 15.0,
          "speed_multiplier": 1.0
        },
        "minecraft:shooter": {
          "def": "veil:soul_ember"
        }
      },

      "veil:phase3": {
        "minecraft:movement": { "value": 0.33 },
        "minecraft:attack": { "damage": 16 },
        "minecraft:behavior.ranged_attack": {
          "priority": 2,
          "attack_interval_min": 1.8,
          "attack_interval_max": 3.0,
          "attack_radius": 16.0,
          "speed_multiplier": 1.1
        },
        "minecraft:shooter": {
          "def": "veil:soul_ember"
        }
      },

      "veil:dying": {
        "minecraft:movement": { "value": 0.0 },
        "minecraft:knockback_resistance": { "value": 1.0 },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": { "filters": {} },
              "deals_damage": false
            }
          ]
        }
      },

      "veil:hp_mp2": {
        "minecraft:health": { "value": 900, "max": 900 }
      },
      "veil:hp_mp3": {
        "minecraft:health": { "value": 1200, "max": 1200 }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": ["monster", "mob", "veil_boss"]
      },
      "minecraft:nameable": {
        "always_show": false,
        "allow_name_tag_renaming": false
      },
      "minecraft:collision_box": { "width": 1.9, "height": 4.2 },
      "minecraft:health": { "value": 600, "max": 600 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:attack": { "damage": 12 },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:fire_immune": true,
      "minecraft:follow_range": { "value": 48, "max": 48 },
      "minecraft:persistent": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "can_walk": true
      },
      "minecraft:boss": {
        "should_darken_sky": true,
        "hud_range": 55
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 1200 : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/noxhollow.json"
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 3,
        "speed_multiplier": 1.0,
        "track_target": true,
        "cooldown_time": 1.2,
        "horizontal_reach": 1.4
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "must_see": false,
        "reselect_targets": true,
        "within_radius": 48,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "player" },
            "max_dist": 48
          }
        ]
      },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 12 },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["veil:phase1"] }
      },
      "veil:to_phase2": {
        "remove": { "component_groups": ["veil:phase1"] },
        "add": { "component_groups": ["veil:phase2"] },
        "set_property": { "veil:phase": 2 }
      },
      "veil:to_phase3": {
        "remove": { "component_groups": ["veil:phase2"] },
        "add": { "component_groups": ["veil:phase3"] },
        "set_property": { "veil:phase": 3 }
      },
      "veil:on_dying": {
        "remove": { "component_groups": ["veil:phase1", "veil:phase2", "veil:phase3"] },
        "add": { "component_groups": ["veil:dying"] }
      },
      "veil:scale_mp2": {
        "add": { "component_groups": ["veil:hp_mp2"] }
      },
      "veil:scale_mp3": {
        "add": { "component_groups": ["veil:hp_mp3"] }
      }
    }
  }
}
