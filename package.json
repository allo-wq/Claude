{
  "name": "venom-mode-addon",
  "version": "1.0.0",
  "description": "Venom Mode: a symbiote add-on for Minecraft Bedrock / Pocket Edition",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "python3 tools/build_assets.py",
    "sounds": "python3 tools/build_sounds.py",
    "build": "python3 tools/build_assets.py && python3 tools/package.py",
    "test": "node --import ./tests/loader.mjs --test tests/venom.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@minecraft/server": "2.0.0",
    "@minecraft/server-ui": "2.0.0",
    "typescript": "^5.9.0"
  }
}
