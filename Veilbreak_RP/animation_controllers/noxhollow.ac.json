{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.veil.noxhollow.general": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "moving": "q.modified_move_speed > 0.08" }
          ],
          "blend_transition": 0.3
        },
        "moving": {
          "animations": ["walk"],
          "transitions": [
            { "idle": "q.modified_move_speed <= 0.08" }
          ],
          "blend_transition": 0.3
        }
      }
    }
  }
}
