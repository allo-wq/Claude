{
  "format_version": "1.8.0",
  "animations": {
    "animation.venom.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.venom.tendrils": {
      "loop": true,
      "bones": {
        "tendril_1": {
          "rotation": [
            "math.sin(q.life_time * 150 + 0) * 14",
            "math.sin(q.life_time * 110 + 40) * 12",
            0
          ]
        },
        "tendril_2": {
          "rotation": [
            "math.sin(q.life_time * 150 + 90) * 14",
            "math.sin(q.life_time * 110 + 40) * -12",
            0
          ]
        },
        "tendril_3": {
          "rotation": [
            "math.sin(q.life_time * 130 + 180) * 12",
            "math.sin(q.life_time * 100 + 10) * 14",
            0
          ]
        },
        "tendril_4": {
          "rotation": [
            "math.sin(q.life_time * 130 + 270) * 12",
            "math.sin(q.life_time * 100 + 10) * -14",
            0
          ]
        }
      }
    },
    "animation.venom.tongue": {
      "loop": true,
      "bones": {
        "tongue": {
          "rotation": [
            "math.sin(q.life_time * 210 + 0) * 7",
            "math.sin(q.life_time * 140 + 0) * 12",
            0
          ]
        }
      }
    },
    "animation.venom.host.move": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "-math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed * 46",
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            "math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed * 46",
            0,
            0
          ]
        },
        "rightLeg": {
          "rotation": [
            "math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed * 64",
            0,
            0
          ]
        },
        "leftLeg": {
          "rotation": [
            "-math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed * 64",
            0,
            0
          ]
        }
      }
    },
    "animation.venom.host.idle": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "math.sin(q.life_time * 100 + 0) * 3",
            0,
            "7 + math.sin(q.life_time * 90 + 0) * 2"
          ]
        },
        "leftArm": {
          "rotation": [
            "math.sin(q.life_time * 100 + 180) * 3",
            0,
            "-7 - math.sin(q.life_time * 90 + 0) * 2"
          ]
        }
      }
    },
    "animation.venom.host.attack": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "-math.sin(variable.attack_time * 180) * 110",
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            "-math.sin(variable.attack_time * 180) * 110",
            0,
            0
          ]
        }
      }
    },
    "animation.venom.symbiote.idle": {
      "loop": true,
      "bones": {
        "body": {
          "scale": [
            "1 + math.sin(q.life_time * 220 + 0) * 0.05",
            "1 - math.sin(q.life_time * 220 + 0) * 0.08",
            "1 + math.sin(q.life_time * 220 + 0) * 0.05"
          ]
        },
        "feeler_r": {
          "rotation": [
            "math.sin(q.life_time * 160 + 0) * 10",
            0,
            "math.sin(q.life_time * 130 + 90) * 8"
          ]
        },
        "feeler_l": {
          "rotation": [
            "math.sin(q.life_time * 160 + 90) * 10",
            0,
            "math.sin(q.life_time * 130 + 90) * -8"
          ]
        }
      }
    },
    "animation.venom.symbiote.crawl": {
      "loop": true,
      "bones": {
        "leg_r_f": {
          "rotation": [
            0,
            "math.sin(q.modified_distance_moved * 140) * 24",
            0
          ]
        },
        "leg_l_f": {
          "rotation": [
            0,
            "math.sin(q.modified_distance_moved * 140 + 180) * 24",
            0
          ]
        },
        "leg_r_m": {
          "rotation": [
            0,
            "math.sin(q.modified_distance_moved * 140 + 120) * 24",
            0
          ]
        },
        "leg_l_m": {
          "rotation": [
            0,
            "math.sin(q.modified_distance_moved * 140 + 300) * 24",
            0
          ]
        },
        "leg_r_b": {
          "rotation": [
            0,
            "math.sin(q.modified_distance_moved * 140 + 240) * 24",
            0
          ]
        },
        "leg_l_b": {
          "rotation": [
            0,
            "math.sin(q.modified_distance_moved * 140 + 60) * 24",
            0
          ]
        }
      }
    }
  }
}
